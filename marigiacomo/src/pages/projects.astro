const riccione = [
  { src: '/images/riccione-1.webp', alt: `Interior of the Riccione store looking towards the entrance`, caption: `Riccione. A narrow unit, which forced better decisions about what earned shelf space.` },
  { src: '/images/riccione-2.webp', alt: `Clothing rails and wall display inside the Riccione store`, caption: `Seasonal town: the assortment had to move faster here than anywhere else.` },
  { src: '/images/riccione-3.webp', alt: `Lit display cabinets of sneakers at the Riccione shopfront`, caption: `The window cabinet did more selling than any campaign we ran.` },
  { src: '/images/riccione-4.webp', alt: `Display shelving and cabinets inside the Riccione store`, caption: `Riccione, after the refit.` },
];

const cortina = [
  { src: '/images/cortina-2.webp', alt: `The Anywhim storefront in Cortina d’Ampezzo during snowfall`, caption: `Cortina d’Ampezzo. Different customer, different price point, entirely different season.` },
  { src: '/images/cortina-1.webp', alt: `Interior of the Cortina store with timber and antler fittings`, caption: `The fit-out came with the building. We worked with it rather than against it.` },
  { src: '/images/cortina-3.webp', alt: `View through the Cortina store interior towards the entrance`, caption: `Long and narrow, which made stock allocation a weekly argument.` },
  { src: '/images/cortina-4.webp', alt: `Sneakers displayed in glass cases in the Cortina store`, caption: `A mountain town in winter: the highest revenue per square metre of the four.` },
