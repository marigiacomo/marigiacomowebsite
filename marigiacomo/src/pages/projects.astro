// All of these are published with the permission of the people in them.
const journey = [
  { src: '/images/journey-5.webp', alt: `Two people working together at a laptop on a workbench`, caption: `Most decisions got made like this, over a laptop, usually late.` },
  { src: '/images/journey-12.webp', alt: `A person standing in front of stacked delivery boxes in an unfinished room`, caption: `A unit before it becomes a shop. This is the part nobody photographs.` },
  { src: '/images/journey-6.webp', alt: `A stockroom filled with shoe boxes, packing materials and unopened deliveries`, caption: `The stockroom, honestly represented.` },
  { src: '/images/journey-8.webp', alt: `A person loading cardboard boxes into the back of a van`, caption: `Moving stock between sites. Four locations means this happens constantly.` },
  { src: '/images/journey-7.webp', alt: `Cardboard boxes of stock stacked on a pavement outside a building`, caption: `A delivery, on a pavement, because the van could not get any closer.` },
  { src: '/images/journey-14.webp', alt: `A person clearing flattened cardboard and empty boxes after a delivery`, caption: `Every delivery ends the same way.` },
  { src: '/images/journey-11.webp', alt: `People kneeling on a shop floor unpacking boxes of shoes before opening`, caption: `Setting up. Everything on the floor before anything is on a shelf.` },
  { src: '/images/journey-9.webp', alt: `A group standing outside the shopfront on opening day`, caption: `Opening day. Worth the months that made it possible.` },
  { src: '/images/journey-10.webp', alt: `A person standing outside the store window`, caption: `Outside the window, which took a long time to earn.` },
  { src: '/images/journey-2.webp', alt: `Three people standing together inside one of the stores`, caption: `Three of us, in a shop that existed because we built it.` },
  { src: '/images/journey-3.webp', alt: `A hand holding a stack of branded Anywhim cups`, caption: `Branded cups. The unglamorous half of building something people recognise.` },
  { src: '/images/journey-13.webp', alt: `Anywhim branded football shirts laid flat`, caption: `We sponsored a local team. Small town, and it worked better than advertising.` },
  { src: '/images/journey-15.webp', alt: `Promotional graphic showing the Anywhim online store on a laptop and phone`, caption: `The e-commerce launch. Ten percent of revenue, and considerably more than ten percent of the work.` },
  { src: '/images/journey-4.webp', alt: `A group sitting together on a sofa in the evening`, caption: `The other half of a small company: the people you end up spending your twenties with.` },
