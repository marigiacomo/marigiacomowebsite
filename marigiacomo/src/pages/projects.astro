const milano = [
  { src: '/images/milano-1.webp', alt: `Display table of sneakers beside a screen in the Milano Marittima store`, caption: `Milano Marittima. The last one we opened, and the one we got right fastest.` },
  { src: '/images/milano-2.webp', alt: `Open-plan interior of the Milano Marittima store with shelving`, caption: `Everything learned from the first three, applied at once.` },
