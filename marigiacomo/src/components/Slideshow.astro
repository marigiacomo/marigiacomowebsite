---
interface Slide {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  label: string;
}

const { slides, label } = Astro.props;
const hasCaptions = slides.some((s) => s.caption);
---

<div class:list={['slideshow', { bare: !hasCaptions }]} data-slideshow aria-roledescription="carousel" aria-label={label}>
  <div class="slides" data-slides tabindex="0" aria-live="polite">
    {slides.map((s, i) => (
      <figure class="slide" data-slide aria-label={`${i + 1} of ${slides.length}`}>
        <img
          src={s.src}
          alt={s.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
        {s.caption && <figcaption>{s.caption}</figcaption>}
      </figure>
    ))}
  </div>

  <div class="controls" data-controls hidden>
    <button type="button" data-prev aria-label={`Previous photo of ${label}`}>&lsaquo;</button>
    <span class="counter" data-counter>1 / {slides.length}</span>
    <button type="button" data-next aria-label={`Next photo of ${label}`}>&rsaquo;</button>
  </div>
</div>

<style>
  .slideshow { margin: 1.25rem 0 2rem; }

  .slides {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .slides::-webkit-scrollbar { display: none; }

  .slides:focus-visible { outline: 1px solid var(--rule); outline-offset: 6px; }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    margin: 0;
    min-width: 0;
  }

  .slide img {
    width: 100%;
    height: min(64vh, 470px);
    object-fit: contain;
    object-position: center;
  }

  .slide figcaption {
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1.55;
    color: var(--ink-faint);
    margin-top: 0.55rem;
    padding-right: 4.5rem;
  }

  /* Deliberately near-invisible until you go looking for it. */
  .controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    margin-top: -1rem;
    opacity: 0.32;
    transition: opacity 140ms ease;
  }

  /* With no caption below the image there is nothing to sit alongside,
     so the negative offset has to go. */
  .slideshow.bare .controls { margin-top: 0.5rem; }

  .slideshow:hover .controls,
  .slideshow:focus-within .controls { opacity: 1; }

  .controls button {
    background: none;
    border: 0;
    padding: 0 0.15rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.9rem;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
  }

  .controls button:hover:not(:disabled) { background: none; color: var(--ink); }
  .controls button:disabled { opacity: 0.25; cursor: default; }

  .counter {
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 36rem) {
    .controls { opacity: 0.55; margin-top: 0.35rem; }
    .slideshow.bare .controls { margin-top: 0.35rem; }
    .slide figcaption { padding-right: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slides { scroll-behavior: auto; }
    .controls { transition: none; }
  }
</style>

<script>
  document.querySelectorAll('[data-slideshow]').forEach((root) => {
    const track = root.querySelector('[data-slides]') as HTMLElement | null;
    const controls = root.querySelector('[data-controls]') as HTMLElement | null;
    const prev = root.querySelector('[data-prev]') as HTMLButtonElement | null;
    const next = root.querySelector('[data-next]') as HTMLButtonElement | null;
    const counter = root.querySelector('[data-counter]') as HTMLElement | null;
    const slides = Array.from(root.querySelectorAll('[data-slide]')) as HTMLElement[];
    if (!track || !controls || !prev || !next || !counter || slides.length < 2) return;

    controls.hidden = false;
    let index = 0;

    const paint = () => {
      counter.textContent = `${index + 1} / ${slides.length}`;
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    };

    const go = (i: number) => {
      index = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft });
      paint();
    };

    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));

    track.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key === 'ArrowRight') { ev.preventDefault(); go(index + 1); }
      if (ev.key === 'ArrowLeft') { ev.preventDefault(); go(index - 1); }
    });

    let tick: number;
    track.addEventListener('scroll', () => {
      window.clearTimeout(tick);
      tick = window.setTimeout(() => {
        const mid = track.scrollLeft + track.clientWidth / 2;
        let closest = 0;
        let best = Infinity;
        slides.forEach((s, i) => {
          const c = s.offsetLeft - track.offsetLeft + s.clientWidth / 2;
          const d = Math.abs(c - mid);
          if (d < best) { best = d; closest = i; }
        });
        index = closest;
        paint();
      }, 90);
    });

    paint();
  });
</script>
